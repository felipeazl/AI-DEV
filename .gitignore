# Working contexts: each one is its own private Git repository
contexts/*/

# Machine configuration (setup creates it; the versioned template is aidw.config.example.toml)
/aidw.config.toml

# Generated by `python aidw.py apply` (each machine generates its own)
/CLAUDE.md
/AGENTS.md
/.mcp.json
/.aidw/
/.claude/skills/
/.claude/agents/
/.claude/settings.local.json
/.codex/
/.agents/

# State of runs without a context
/state/*
!/state/.gitkeep

# Secrets
.env
.env.*

# Playwright MCP page snapshots and logs
/.playwright-mcp/

# Python
__pycache__/
*.pyc
.venv/
